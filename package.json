{
  "name": "jimmy",
  "version": "1.0.4",
  "description": "A beautiful, transparent productivity widget for Windows, inspired by macOS Dynamic Island and Braun design.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.kennethkcox.jimmy",
    "productName": "Jimmy",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kennethkcox/jimmy.git"
  },
  "author": "Kenneth Cox",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.4.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
